<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NeoWolf.app's Info.plist. Configured by cmake/Packaging.cmake (configure_file @ONLY);
     the values come from CMakeLists.txt (version) and cmake/Packaging.cmake (bundle id). -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>@NEOWOLF_DISPLAY_NAME@</string>
	<key>CFBundleExecutable</key>
	<string>@NEOWOLF_APP_EXECUTABLE@</string>
	<key>CFBundleIconFile</key>
	<string>@NEOWOLF_APP_ICON_FILE@</string>
	<key>CFBundleIdentifier</key>
	<string>@NEOWOLF_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@NEOWOLF_DISPLAY_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@PROJECT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@PROJECT_VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.games</string>
	<key>LSMinimumSystemVersion</key>
	<string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
	<key>NSHumanReadableCopyright</key>
	<string>@NEOWOLF_COPYRIGHT@</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
</dict>
</plist>
