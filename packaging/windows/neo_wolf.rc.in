// neo_wolf.exe's resources: the application icon and the version resource (Explorer shows
// both: the icon, and Properties > Details). Configured by cmake/Packaging.cmake
// (configure_file @ONLY); the version comes from project(VERSION) in CMakeLists.txt.
// Compiled by rc.exe (MSVC) and by windres (MinGW).
#include <winver.h>

@NEOWOLF_RC_ICON_LINE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "@NEOWOLF_REPOSITORY_URL@"
            VALUE "CompanyName", "Neo-Wolf project"
            VALUE "FileDescription", "@NEOWOLF_DISPLAY_NAME@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "neo_wolf"
            VALUE "LegalCopyright", "@NEOWOLF_COPYRIGHT@"
            VALUE "OriginalFilename", "neo_wolf.exe"
            VALUE "ProductName", "@NEOWOLF_DISPLAY_NAME@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
